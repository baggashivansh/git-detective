# PostgreSQL
POSTGRES_DB=gitdetective
POSTGRES_USER=gitdetective
POSTGRES_PASSWORD=gitdetective
POSTGRES_PORT=5432

# Backend
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
BACKEND_PORT=8080
APP_VERSION=1.0.0
DATABASE_URL=jdbc:postgresql://localhost:5432/gitdetective
DATABASE_USERNAME=gitdetective
DATABASE_PASSWORD=gitdetective
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Analysis limits
WORKSPACE_ROOT=
CLONE_TIMEOUT_SECONDS=300
MAX_REPOSITORY_SIZE_BYTES=524288000
MAX_FILES=50000
MAX_COMMITS=10000

# Rate limiting (POST analyze / investigations / assistant)
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# AI Assistant
# stub-mode=true uses deterministic evidence-backed answers (no external API)
AI_STUB_MODE=true
AI_API_KEY=
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_CONNECT_TIMEOUT_MS=10000
AI_READ_TIMEOUT_MS=120000
